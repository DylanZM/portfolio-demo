---
import ProyectIcon from './icons/proyect.astro';
import Card from './Card.astro';
import Arrow from './icons/Arrow.astro';

---

<section id="projects" class="w-full py-16 px-6 sm:px-8 md:px-0 md:max-w-4xl md:mx-auto scroll-mt-24 reveal">
  <div class="flex flex-col gap-2 mb-10 text-left">
    <h2 class="flex flex-wrap items-center gap-3 text-[1.5rem] md:text-[2rem] tracking-wide font-medium">
      <ProyectIcon />
      projects
      <div class="border-t border-primary line-draw"></div>
      <a href="#projects" class="ml-auto flex items-center gap-2 text-xs font-medium whitespace-nowrap" style="color: var(--secondary);">
        View all
      <Arrow />
      </a>
    </h2>
    <p class="text-sm md:text-base" style="color: var(--secondary)">
      Here are some of the projects I've worked on.
    </p>
  </div>

  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 reveal-stagger">
    <Card
      img="https://images.unsplash.com/photo-1507238691740-187a5b1d37b8?w=600&h=400&fit=crop"
      alt="Portfolio"
      title="Portfolio"
      description="My personal portfolio made with Astro and Tailwind CSS."
      github="https://github.com/DylanZM/portfolio"
      tags={[
        { name: "Astro", icon: "astro" },
        { name: "Tailwind CSS", icon: "tailwind" }
      ]}
    />
    <Card
      img="/src/assets/proyects/playground.png"
      alt="E-Commerce"
      title="Playground"
      description="Online Playground for C/C++."
      github="https://github.com/DylanZM/cgo"
      tags={[
        { name: "React", icon: "react" },
        { name: "Node.js", icon: "node" },
        { name: "MongoDB", icon: "mongo" }
      ]}
    />
    <Card
      img="/src/assets/proyects/task-manager.png"
      alt="Task Manager"
      title="Task Manager"
      description="Task management application with user authentication."
      github="https://github.com/DylanZM/task-manager"
      demo="https://task-manager-sigma-pied-92.vercel.app/login"
      tags={[
        { name: "Next.js", icon: "nextjs" },
        { name: "Tailwind CSS", icon: "tailwind" }
      ]}
    />
  </div>
</section>
