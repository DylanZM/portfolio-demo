---
import ProyectIcon from './icons/proyect.astro';
import Arrow from './icons/Arrow.astro';
import Card from './Card.astro';
---

<section id="projects" class="w-full py-16 px-6 md:px-0 md:max-w-4xl md:mx-auto scroll-mt-24 reveal">
  <div class="flex flex-col gap-2 mb-10 text-center md:text-left">
    <h2 class="flex items-center gap-3 text-[2rem] tracking-wide font-medium">
      <ProyectIcon />
      projects
      <div class="border-t border-primary line-draw"></div>
      <a href="#projects" class="ml-auto flex items-center gap-2 text-xs font-medium whitespace-nowrap " style="color: var(--secondary);">
        View all
      <Arrow />
      </a>
    </h2>
    <p class="text-sm md:text-base" style="color: var(--secondary)">
      Here are some of the projects I've worked on.
    </p>
  </div>

  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 reveal-stagger">
    <Card
      img="https://images.unsplash.com/photo-1507238691740-187a5b1d37b8?w=600&h=400&fit=crop"
      alt="Portfolio"
      title="Portfolio"
      description="My personal portfolio made with Astro and Tailwind CSS."
      tags={["Astro", "Tailwind CSS"]}
    />
    <Card
      img="https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?w=600&h=400&fit=crop"
      alt="E-Commerce"
      title="E-Commerce"
      description="Online store with shopping cart and payment gateway."
      tags={["React", "Node.js", "MongoDB"]}
    />
    <Card
      img="https://images.unsplash.com/photo-1611224923853-80b023f02d71?w=600&h=400&fit=crop"
      alt="Task Manager"
      title="Task Manager"
      description="Task management application with user authentication."
      tags={["Vue.js", "Firebase"]}
    />
  </div>
</section>
