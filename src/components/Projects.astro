---
---

<section id="projects" class="w-full py-16 px-6 md:px-0 md:max-w-4xl md:mx-auto">
  <div class="flex flex-col gap-2 mb-10 text-center md:text-left">
    <h2 class="text-3xl font-bold tracking-wide md:text-4xl">
      My <span class="text-primary">Projects</span>
    </h2>
    <p class="text-sm md:text-base" style="color: var(--secondary)">
      Here are some of the projects I've worked on.
    </p>
  </div>

  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
    <div class="flex flex-col gap-3 p-4 rounded-lg border transition-colors duration-200 hover:border-primary" style="border-color: var(--border); background: var(--surface);">
      <img src="https://placehold.co/600x400/1a1d21/abb2bf?text=Portfolio" alt="Portfolio" class="w-full h-40 object-cover rounded-md" />
      <h3 class="text-lg font-bold">Portfolio</h3>
      <p class="text-xs md:text-sm" style="color: var(--secondary)">My personal portfolio made with Astro and Tailwind CSS.</p>
      <div class="flex flex-wrap gap-2">
        <span class="text-xs px-2 py-1 rounded border border-primary text-primary">Astro</span>
        <span class="text-xs px-2 py-1 rounded border border-primary text-primary">Tailwind CSS</span>
      </div>
      <div class="flex gap-3 mt-auto">
        <a href="#" target="_blank" class="text-xs font-medium py-1 px-3 border border-primary transition-colors duration-200 hover:bg-primary hover:text-white">GitHub</a>
        <a href="#" target="_blank" class="text-xs font-medium py-1 px-3 border transition-colors duration-200 hover:bg-primary hover:text-white" style="border-color: var(--border); color: var(--secondary);">Demo</a>
      </div>
    </div>

    <div class="flex flex-col gap-3 p-4 rounded-lg border transition-colors duration-200 hover:border-primary" style="border-color: var(--border); background: var(--surface);">
      <img src="https://placehold.co/600x400/1a1d21/abb2bf?text=E-Commerce" alt="E-Commerce" class="w-full h-40 object-cover rounded-md" />
      <h3 class="text-lg font-bold">E-Commerce</h3>
      <p class="text-xs md:text-sm" style="color: var(--secondary)">Online store with shopping cart and payment gateway.</p>
      <div class="flex flex-wrap gap-2">
        <span class="text-xs px-2 py-1 rounded border border-primary text-primary">React</span>
        <span class="text-xs px-2 py-1 rounded border border-primary text-primary">Node.js</span>
        <span class="text-xs px-2 py-1 rounded border border-primary text-primary">MongoDB</span>
      </div>
      <div class="flex gap-3 mt-auto">
        <a href="#" target="_blank" class="text-xs font-medium py-1 px-3 border border-primary transition-colors duration-200 hover:bg-primary hover:text-white">GitHub</a>
        <a href="#" target="_blank" class="text-xs font-medium py-1 px-3 border transition-colors duration-200 hover:bg-primary hover:text-white" style="border-color: var(--border); color: var(--secondary);">Demo</a>
      </div>
    </div>

    <div class="flex flex-col gap-3 p-4 rounded-lg border transition-colors duration-200 hover:border-primary" style="border-color: var(--border); background: var(--surface);">
      <img src="https://placehold.co/600x400/1a1d21/abb2bf?text=Task+Manager" alt="Task Manager" class="w-full h-40 object-cover rounded-md" />
      <h3 class="text-lg font-bold">Task Manager</h3>
      <p class="text-xs md:text-sm" style="color: var(--secondary)">Task management application with user authentication.</p>
      <div class="flex flex-wrap gap-2">
        <span class="text-xs px-2 py-1 rounded border border-primary text-primary">Vue.js</span>
        <span class="text-xs px-2 py-1 rounded border border-primary text-primary">Firebase</span>
      </div>
      <div class="flex gap-3 mt-auto">
        <a href="#" target="_blank" class="text-xs font-medium py-1 px-3 border border-primary transition-colors duration-200 hover:bg-primary hover:text-white">GitHub</a>
        <a href="#" target="_blank" class="text-xs font-medium py-1 px-3 border transition-colors duration-200 hover:bg-primary hover:text-white" style="border-color: var(--border); color: var(--secondary);">Demo</a>
      </div>
    </div>
  </div>
</section>
