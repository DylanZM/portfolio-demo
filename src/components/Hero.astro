---
import Button from "./Button.astro";
import { MapPin } from "@lucide/astro";
import heroGif from "../assets/bloub-first-cicleF.gif";
---

<section
  class="flex flex-col items-start justify-center w-full py-8 gap-6 px-6 sm:px-8 md:flex-row md:max-w-4xl md:mx-auto md:items-center md:gap-16 md:min-h-[calc(100vh-80px)] md:py-0"
>
  <div class="flex flex-col items-start gap-3 text-left md:w-1/2 hero-stagger">
    <h1
      class="text-2xl font-bold tracking-wide whitespace-nowrap sm:text-3xl md:text-4xl"
    >
      <span data-i18n="hero.greeting">Hi, I'm</span> <span class="text-primary">Dylan</span>
    </h1>
    <h2
      class="text-base font-semibold whitespace-nowrap sm:text-xl md:text-2xl"
    >
      <span class="text-primary" data-i18n="hero.role1">Frontend Developer</span> <span data-i18n="hero.and">and</span> <span
        class="text-primary" data-i18n="hero.role2">Web Developer</span
      >
    </h2>
    <div class="flex items-center gap-1.5 mt-1">
      <MapPin class="w-4 h-4 text-primary" />
      <span class="text-secondary text-sm font-medium"
        >Dominican Republic 🇩🇴</span
      >
    </div>
    <p
      class="max-w-sm text-sm leading-relaxed sm:max-w-md sm:text-base text-secondary"
      data-i18n="hero.description" data-i18n-html
    >
      I'm a passionate developer with <span class="text-primary font-medium">+3 years</span> of experience creating beautiful and functional web applications.
    </p>
    <div class="mt-2">
      <Button data-i18n="hero.cta"> Contact Me!! </Button>
    </div>
  </div>
  <div
    class="flex flex-col items-start gap-2 mt-4 md:mt-0 md:w-1/2 md:items-center md:pl-15"
  >
    <div class="relative">
      <img
        id="hero-gif"
        src={heroGif.src}
        alt="DylanZM"
        class="w-44 h-44 object-cover sm:w-56 sm:h-56 md:w-80 md:h-80"
        style="transform: scaleX(-1) translate(0px, 0px); transition: transform 0.3s cubic-bezier(0.23, 1, 0.32, 1);"
      />
    </div>
    <Button
      class="border-secondary font-medium leading-tight text-xs sm:text-sm px-4 whitespace-nowrap"
    >
      <span data-i18n="hero.status">Currently working on</span> <span class="font-semibold">Portfolio</span>
    </Button>
  </div>
</section>

<script is:inline>
  (function () {
    const gif = document.getElementById("hero-gif");
    if (!gif) return;

    let targetX = 0,
      targetY = 0,
      currentX = 0,
      currentY = 0;

    document.addEventListener("mousemove", (e) => {
      const rect = gif.getBoundingClientRect();
      const centerX = rect.left + rect.width / 2;
      const centerY = rect.top + rect.height / 2;

      const diffX = e.clientX - centerX;
      const diffY = e.clientY - centerY;

      const maxMove = 20;
      const distance = Math.sqrt(diffX * diffX + diffY * diffY);
      const maxDist = 400;

      const factor = Math.min(distance / maxDist, 1);
      targetX = (diffX / (distance || 1)) * maxMove * factor;
      targetY = (diffY / (distance || 1)) * maxMove * factor;
    });

    function animate() {
      currentX += (targetX - currentX) * 0.08;
      currentY += (targetY - currentY) * 0.08;

      gif.style.transform = `scaleX(-1) translate(${currentX}px, ${currentY}px)`;
      requestAnimationFrame(animate);
    }
    animate();
  })();
</script>
