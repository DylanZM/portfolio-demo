  stroke="currentColor"
  stroke-width="12"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path
    d="M 30,50 C 45,25 55,25 70,50 C 85,75 95,75 110,50 C 125,25 135,25 150,50 C 165,75 175,75 190,50 L 210,50"
  ></path>
  <path d="M 190,25 L 215,50 L 190,75"></path>
</svg>
