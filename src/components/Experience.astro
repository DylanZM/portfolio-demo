---
import { Briefcase } from "@lucide/astro";
---

<section id="experience" class="w-full py-16 px-6 sm:px-8 md:px-0 md:max-w-4xl md:mx-auto scroll-mt-24 reveal reveal-stagger">
  <div>
    <h2 class="flex flex-wrap items-center gap-3 text-[1.5rem] md:text-[2rem] tracking-wide font-medium">
      <span class="inline-flex">
        <Briefcase size={24} class="text-primary" />
      </span>
      <span>experience</span>
      <div class="border-t border-primary line-draw" style="max-width: 326px;"></div>
    </h2>
    <p class="text-sm md:text-base mt-2 text-secondary">
      My professional journey.
    </p>
  </div>

  <div class="mt-10 relative">
    <div class="absolute left-1.5 top-0 bottom-0 w-px bg-secondary hidden md:block"></div>

    <div class="flex flex-col gap-10">
      <div class="reveal-child relative md:pl-8">
        <div class="absolute left-0 top-1 w-3 h-3 rounded-full bg-primary hidden md:block"></div>
        <div class="flex flex-col md:flex-row md:gap-6">
          <div class="flex flex-col gap-1 md:w-1/2 shrink-0">
            <span class="text-xs text-secondary">2024 - 2026</span>
            <h3 class="text-lg font-medium">Full Stack Developer</h3>
            <span class="text-sm text-primary">Pomaray</span>
          </div>
          <p class="mt-3 md:mt-0 text-sm leading-relaxed text-secondary md:w-1/2">
            Contributed to the development of a full stack educational platform, working on both frontend and backend to deliver learning tools and improve the user experience for students and educators.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
