---
import { Briefcase } from "@lucide/astro";
---

<section id="experience" class="w-full py-16 px-6 sm:px-8 md:px-0 md:max-w-4xl md:mx-auto scroll-mt-24 reveal">
  <div class="exp-header flex flex-col gap-2 mb-10 text-left">
    <h2 class="flex flex-wrap items-center gap-3 text-[1.5rem] md:text-[2rem] tracking-wide font-medium">
      <span class="exp-icon inline-flex">
        <Briefcase size={24} class="text-primary" />
      </span>
      <span data-i18n="experience.heading">experience</span>
      <div class="border-t border-primary line-draw" style="max-width: 326px;"></div>
    </h2>
    <p class="text-sm md:text-base text-secondary" data-i18n="experience.subtitle">
      My professional journey.
    </p>
  </div>

  <div class="mt-10 relative">
    <div class="timeline-line absolute left-1.5 top-0 bottom-0 w-px bg-secondary hidden md:block"></div>

    <div class="flex flex-col gap-10 reveal-stagger">
      <div class="reveal-child relative md:pl-8">
        <div class="timeline-dot absolute left-0 top-1 w-3 h-3 rounded-full bg-primary hidden md:block"></div>
        <div class="flex flex-col md:flex-row md:gap-6">
          <div class="flex flex-col gap-1 md:w-1/2 shrink-0">
            <span class="text-xs text-secondary" data-i18n="experience.date1">2024 - 2026</span>
            <h3 class="text-lg font-medium" data-i18n="experience.title1">Full Stack Developer</h3>
            <span class="text-sm text-primary" data-i18n="experience.company1">Pomaray</span>
          </div>
          <p class="mt-3 md:mt-0 text-sm leading-relaxed text-secondary md:w-1/2" data-i18n="experience.desc1">
            Contributed to the development of a full stack educational platform, working on both frontend and backend to deliver learning tools and improve the user experience for students and educators.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .exp-header .exp-icon {
    opacity: 0;
    transform: scale(0.5) rotate(-20deg);
    transition: opacity 0.7s var(--ease-out), transform 0.7s var(--ease-out);
  }

  .visible .exp-header .exp-icon {
    opacity: 1;
    transform: scale(1) rotate(0deg);
  }

  .timeline-line {
    transform-origin: top;
    transform: scaleY(0);
    transition: transform 1s var(--ease-in-out) 0.3s;
  }

  .visible .timeline-line {
    transform: scaleY(1);
  }

  .timeline-dot {
    opacity: 0;
    transform: scale(0);
    transition: opacity 0.4s var(--ease-out) 0.5s, transform 0.4s var(--ease-out) 0.5s;
  }

  .visible .timeline-dot {
    opacity: 1;
    transform: scale(1);
  }

  .reveal-child {
    opacity: 0;
    transform: translateX(-10px);
    transition: opacity 0.6s var(--ease-out), transform 0.6s var(--ease-out);
  }

  .reveal-stagger.visible .reveal-child {
    opacity: 1;
    transform: translateX(0);
  }

  .reveal-stagger.visible .reveal-child:nth-child(1) { transition-delay: 0.4s; }
  .reveal-stagger.visible .reveal-child:nth-child(2) { transition-delay: 0.55s; }
  .reveal-stagger.visible .reveal-child:nth-child(3) { transition-delay: 0.7s; }
</style>
