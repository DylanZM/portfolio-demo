---
import GitHubIcon from "./icons/GitHub.astro";
import TechIcon from "./icons/Technologies.astro";
import Button from "./Button.astro";
import { ChevronsLeftRightEllipsis, ArrowUpRight } from "@lucide/astro";

const {
  img = "",
  alt = "Project",
  title,
  description,
  tags = [],
  github = "#",
  demo = "#",
} = Astro.props;
---

<div
  class="group flex flex-col reveal-child border border-secondary overflow-hidden transition-all duration-250 ease-out hover:-translate-y-1 hover:border-primary"
  style="background: var(--surface);"
>
  <div class="overflow-hidden">
    <img src={img} alt={alt} class="w-full h-48 object-cover transition-all duration-500 ease-out group-hover:scale-105 group-hover:brightness-110" />
  </div>

  <div class="flex flex-col gap-3 flex-1 p-5">
    <div class="flex flex-wrap gap-1.5">
      {
        tags.map((tag: { name: string; icon: string }) => (
          <span
            class="inline-flex items-center gap-1 text-[10px] font-medium tracking-wider px-2 py-0.5 border border-secondary"
            style="background: color-mix(in srgb, var(--gray) 20%, var(--secondary) 10%); color: var(--secondary);"
          >
            <TechIcon name={tag.icon} />
            {tag.name}
          </span>
        ))
      }
    </div>

    <div class="flex items-start justify-between gap-2">
      <h3 class="text-xl font-medium leading-snug">{title}</h3>
      <ArrowUpRight
        size={16}
        class="shrink-0 mt-0.5 text-primary opacity-0 -translate-x-1 translate-y-1 transition-all duration-300 group-hover:opacity-100 group-hover:translate-x-0 group-hover:translate-y-0"
      />
    </div>

    <p class="text-sm leading-relaxed" style="color: var(--secondary)">
      {description}
    </p>

    <div class="flex gap-3 mt-auto pt-2">
      <Button href={github} target="_blank" border="border-secondary">
        <GitHubIcon width={16} height={16} />
        GitHub
      </Button>
      {demo && demo !== "#" && (
        <Button
          href={demo}
          target="_blank"
          border="border-primary"
          style="color: var(--primary);"
        >
          <ChevronsLeftRightEllipsis width={16} height={16} />
          Preview
        </Button>
      )}
    </div>
  </div>
</div>
