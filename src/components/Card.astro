---
import GitHubIcon from "./icons/GitHub.astro";
import TechIcon from "./icons/Technologies.astro";
import Button from "./Button.astro";
import { ChevronsLeftRightEllipsis } from "@lucide/astro";

const {
  img = "",
  alt = "Project",
  title,
  description,
  tags = [],
  github = "#",
  demo = "#",
} = Astro.props;
---

<div class="card-hover flex flex-col reveal-child border border-secondary" style="background: var(--surface);">
  <div class="overflow-hidden">
    <img src={img} alt={alt} class="w-full h-40 object-cover" />
  </div>
  <div
    class="flex flex-wrap justify-start gap-1.5 pl-3 pr-4 py-2"
    style="background: var(--surface);"
  >
    {
      tags.map((tag: { name: string; icon: string }) => (
        <span
          class="inline-flex items-center gap-1 text-[10px] font-medium tracking-wider px-2 py-0.5 border border-secondary"
          style="background: color-mix(in srgb, var(--gray) 20%, var(--secondary) 10%); color: var(--secondary);"
        >
          <TechIcon name={tag.icon} />
          {tag.name}
        </span>
      ))
    }
  </div>
  <div class="border-b border-secondary" style="background: var(--secondary);"></div>
  <div
    class="flex flex-col gap-3 p-4"
    style="background: var(--surface);"
  >
    <h3 class="text-lg font-medium">{title}</h3>
    <p class="text-xs md:text-sm" style="color: var(--secondary)">
      {description}
    </p>
    <div class="flex gap-3 mt-auto">
      <Button href={github} target="_blank" border="border-secondary">
        <GitHubIcon width={16} height={16} />
        GitHub
      </Button>
      <Button
        href={demo}
        target="_blank"
        border="border-primary"
        style="color: var(--secondary);"
      >
        <ChevronsLeftRightEllipsis width={16} height={16} />
        Preview
      </Button>
    </div>
  </div>
</div>
