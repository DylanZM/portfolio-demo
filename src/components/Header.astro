---
import ThemeToggle from "./ThemeToggle.astro";
import GitHubIcon from "./icons/GitHub.astro";
import Mail from "./icons/Mail.astro";
import Logo from "./icons/Logo.astro";
import MorphIcon from "morphicons/astro";
import { ChevronDown, Menu, Moon, Sun, X } from "lucide";
---

<header class="fixed top-0 left-0 right-0 z-50 w-full backdrop-blur-md overflow-visible" style="background: color-mix(in srgb, var(--bg) 85%, transparent);">
  <nav
    class="relative flex items-center justify-between max-w-4xl px-4 py-6 mx-auto md:px-0"
  >
    <div class="rail-line absolute top-0 -left-30 border-l-1 border-secondary h-35 dark:border-lightsecondary"></div>
    <div class="absolute top-37 -left-30 -translate-x-1/2 flex flex-col items-center gap-4">
      <ThemeToggle class="text-secondary rail-item d1" />
      <a href="https://github.com/DylanZM" target="_blank" class="rail-item d2 text-secondary hover:text-primary transition-colors duration-200">
        <GitHubIcon width={20} height={20} />
      </a>
      <a href="mailto:dylanzarzuela62@gmail.com" class="rail-item d3 text-secondary hover:text-primary transition-colors duration-200">
        <Mail width={20} height={20} />
      </a>
    </div>

    <a href="/" class="flex items-center gap-2 text-lg font-bold tracking-wide md:text-xl">
      <Logo width={28} height={28} class="text-primary" />
      DylanZM
    </a>

    <!-- Desktop nav -->
    <ul
      class="hidden items-center space-x-6 text-sm font-medium tracking-wide md:flex"
    >
      <li>
        <a href="#projects" class="relative transition-colors duration-200 after:content-[''] after:absolute after:left-0 after:top-full after:mt-1 after:w-0 after:h-[3px] after:bg-primary after:transition-all after:duration-300 hover:after:w-full" data-i18n="nav.projects">Projects</a>
      </li>
      <li>
        <a href="#experience" class="relative transition-colors duration-200 after:content-[''] after:absolute after:left-0 after:top-full after:mt-1 after:w-0 after:h-[3px] after:bg-primary after:transition-all after:duration-300 hover:after:w-full" data-i18n="nav.experience">Experience</a>
      </li>
      <li>
        <a href="#about" class="relative transition-colors duration-200 after:content-[''] after:absolute after:left-0 after:top-full after:mt-1 after:w-0 after:h-[3px] after:bg-primary after:transition-all after:duration-300 hover:after:w-full" data-i18n="nav.about">About</a>
      </li>
      <li>
        <a href="#contact" class="relative transition-colors duration-200 after:content-[''] after:absolute after:left-0 after:top-full after:mt-1 after:w-0 after:h-[3px] after:bg-primary after:transition-all after:duration-300 hover:after:w-full" data-i18n="nav.contact">Contact</a>
      </li>
      <li class="relative">
        <button id="lang-toggle" type="button" aria-label="Toggle language" aria-expanded="false" class="flex items-center gap-2 cursor-pointer">
          <span id="lang-label">EN</span>
          <MorphIcon icon={ChevronDown} size={20} />
        </button>
        <ul id="lang-dropdown" class="lang-dropdown absolute top-full right-0 mt-2 py-1 px-3 border border-secondary text-sm font-semibold" style="background: var(--surface);">
          <li><button class="lang-option cursor-pointer block w-full text-left py-1 hover:text-primary transition-colors" data-lang="en">EN</button></li>
          <li><button class="lang-option cursor-pointer block w-full text-left py-1 hover:text-primary transition-colors" data-lang="es">ES</button></li>
        </ul>
      </li>
    </ul>

    <!-- Mobile menu toggle -->
    <button id="mobile-menu-toggle" type="button" aria-label="Toggle menu" aria-expanded="false" class="md:hidden flex items-center justify-center w-10 h-10 text-secondary hover:text-primary transition-colors duration-200 cursor-pointer">
      <MorphIcon icon={Menu} size={24} id="mobile-menu-icon" />
    </button>
  </nav>
</header>

<!-- Mobile menu panel (outside header for proper z-index) -->
<div id="mobile-menu" class="mobile-menu md:hidden" aria-hidden="true">
  <div class="mobile-menu-panel">
    <div class="mobile-menu-header">
      <a href="/" class="mobile-brand">DylanZM</a>
      <button id="mobile-menu-close" type="button" aria-label="Close menu" class="mobile-menu-close">
        <MorphIcon icon={X} size={22} />
      </button>
    </div>

    <nav class="mobile-nav" aria-label="Mobile navigation">
      <a href="#projects" class="mobile-nav-link" data-i18n="nav.projects"><span>#</span>projects</a>
      <a href="#experience" class="mobile-nav-link" data-i18n="nav.experience"><span>#</span>experience</a>
      <a href="#about" class="mobile-nav-link" data-i18n="nav.about"><span>#</span>about</a>
      <a href="#contact" class="mobile-nav-link" data-i18n="nav.contact"><span>#</span>contact</a>
    </nav>

    <div class="mobile-menu-footer">
      <div class="mobile-lang-switch">
        <button class="mobile-lang-btn active" data-lang="en">EN</button>
        <span class="text-primary">/</span>
        <button class="mobile-lang-btn" data-lang="es">ES</button>
      </div>

      <div class="mobile-socials">
        <button id="mobile-theme-toggle" type="button" aria-label="Toggle theme" class="mobile-social-icon theme-switch">
          <MorphIcon id="mobile-theme-icon" icon={Sun} size={18} />
        </button>
        <a href="https://github.com/DylanZM" target="_blank" rel="noreferrer" class="mobile-social-icon" aria-label="GitHub">
          <GitHubIcon width={18} height={18} />
        </a>
        <a href="mailto:dylanzarzuela62@gmail.com" class="mobile-social-icon" aria-label="Email">
          <Mail width={18} height={18} />
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  import { ChevronDown, ChevronUp, Menu, Moon, Sun, X } from "lucide";
  import type { MorphIconElement } from "morphicons/element";

  // Language toggle (desktop)
  const btn = document.querySelector<HTMLButtonElement>("#lang-toggle")!;
  const icon = btn.querySelector<MorphIconElement>("morph-icon")!;
  const dropdown = document.querySelector<HTMLUListElement>("#lang-dropdown")!;
  const label = document.querySelector<HTMLSpanElement>("#lang-label")!;

  btn.addEventListener("click", () => {
    const open = btn.getAttribute("aria-expanded") !== "true";
    btn.setAttribute("aria-expanded", String(open));
    icon.icon = open ? ChevronUp : ChevronDown;
    dropdown.classList.toggle("lang-dropdown-open", open);
  });

  document.querySelectorAll(".lang-option").forEach((option) => {
    option.addEventListener("click", () => {
      const lang = option.getAttribute("data-lang")!;
      label.textContent = lang.toUpperCase();
      dropdown.classList.remove("lang-dropdown-open");
      btn.setAttribute("aria-expanded", "false");
      icon.icon = ChevronDown;

      if (typeof (window as any).translateTo === "function") {
        (window as any).translateTo(lang);
      }
    });
  });

  document.addEventListener("click", (e) => {
    if (!btn.contains(e.target as Node) && !dropdown.contains(e.target as Node)) {
      dropdown.classList.remove("lang-dropdown-open");
      btn.setAttribute("aria-expanded", "false");
      icon.icon = ChevronDown;
    }
  });

  // Mobile menu
  const mobileToggle = document.querySelector<HTMLButtonElement>("#mobile-menu-toggle")!;
  const mobileMenu = document.querySelector<HTMLDivElement>("#mobile-menu")!;
  const mobileMenuClose = document.querySelector<HTMLButtonElement>("#mobile-menu-close")!;
  const mobileIcon = mobileToggle.querySelector<MorphIconElement>("morph-icon")!;
  const mobileThemeButton = document.querySelector<HTMLButtonElement>("#mobile-theme-toggle")!;
  const mobileThemeIcon = mobileThemeButton.querySelector<MorphIconElement>("morph-icon")!;

  const closeMobileMenu = () => {
    mobileMenu.classList.remove("mobile-menu-open");
    mobileMenu.setAttribute("aria-hidden", "true");
    mobileToggle.setAttribute("aria-expanded", "false");
    mobileIcon.icon = Menu;
  };

  const openMobileMenu = () => {
    mobileMenu.classList.add("mobile-menu-open");
    mobileMenu.setAttribute("aria-hidden", "false");
    mobileToggle.setAttribute("aria-expanded", "true");
    mobileIcon.icon = X;
  };

  mobileToggle.addEventListener("click", () => {
    const open = mobileMenu.classList.contains("mobile-menu-open");
    if (open) {
      closeMobileMenu();
    } else {
      openMobileMenu();
    }
  });

  mobileMenuClose.addEventListener("click", closeMobileMenu);

  mobileMenu.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", closeMobileMenu);
  });

  document.addEventListener("click", (e) => {
    if (!mobileMenu.classList.contains("mobile-menu-open")) return;
    if (!mobileMenu.contains(e.target as Node) && !mobileToggle.contains(e.target as Node)) {
      closeMobileMenu();
    }
  });

  // Mobile language switch
  document.querySelectorAll(".mobile-lang-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const lang = btn.getAttribute("data-lang")!;
      label.textContent = lang.toUpperCase();
      
      // Update active state
      document.querySelectorAll(".mobile-lang-btn").forEach(b => b.classList.remove("active"));
      btn.classList.add("active");
      
      if (typeof (window as any).translateTo === "function") {
        (window as any).translateTo(lang);
      }
    });
  });

  const updateThemeButton = () => {
    const dark = document.documentElement.classList.contains("dark");
    mobileThemeIcon.icon = dark ? Moon : Sun;
  };

  updateThemeButton();

  mobileThemeButton.addEventListener("click", () => {
    const dark = document.documentElement.classList.toggle("dark");
    localStorage.setItem("theme", dark ? "light" : "dark");
    updateThemeButton();
  });
</script>
