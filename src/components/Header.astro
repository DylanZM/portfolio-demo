---
import ThemeToggle from "./ThemeToggle.astro";
import GitHubIcon from "./GitHub.astro";
---

<nav
  class="relative flex items-center justify-between w-full max-w-4xl px-4 py-6 mx-auto text-white md:px-0"
>
  <div class="absolute top-0 -left-30 border-l-1 border-gray h-35"></div>
  <div class="absolute top-37 -left-30 -translate-x-1/2 flex flex-col items-center gap-4">
    <ThemeToggle class="text-gray" />
    <GitHubIcon class="text-gray" />
  </div>

  <a href="/" class="text-lg font-bold tracking-wide text-white md:text-xl"
    >DylanZM</a
  >
  <ul
    class="hidden items-center space-x-6 text-sm font-medium tracking-wide md:flex"
  >
    <li>
      <a
        href="/"
        class="relative transition-colors duration-200 after:content-[''] after:absolute after:left-0 after:top-full after:mt-1 after:w-0 after:h-[3px] after:bg-primary after:transition-all after:duration-300 hover:after:w-full"
        >Home</a
      >
    </li>
    <li>
      <a
        href="/about"
        class="relative transition-colors duration-200 after:content-[''] after:absolute after:left-0 after:top-full after:mt-1 after:w-0 after:h-[3px] after:bg-primary after:transition-all after:duration-300 hover:after:w-full"
        >About</a
      >
    </li>
    <li>
      <a
        href="/projects"
        class="relative transition-colors duration-200 after:content-[''] after:absolute after:left-0 after:top-full after:mt-1 after:w-0 after:h-[3px] after:bg-primary after:transition-all after:duration-300 hover:after:w-full"
        >Projects</a
      >
    </li>
    <li>
      <a
        href="/contact"
        class="relative transition-colors duration-200 after:content-[''] after:absolute after:left-0 after:top-full after:mt-1 after:w-0 after:h-[3px] after:bg-primary after:transition-all after:duration-300 hover:after:w-full"
        >Contact</a
      >
    </li>
  </ul>
</nav>
