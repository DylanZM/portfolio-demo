---
import ThemeToggle from "./ThemeToggle.astro";
import GitHubIcon from "./icons/GitHub.astro";
import Mail from "./icons/Mail.astro";
import MorphIcon from "morphicons/astro";
import { ChevronDown } from "lucide";
---

<header class="fixed top-0 left-0 right-0 z-50 w-full backdrop-blur-md overflow-visible" style="background: color-mix(in srgb, var(--bg) 85%, transparent);">
  <nav
    class="relative flex items-center justify-between max-w-4xl px-4 py-6 mx-auto md:px-0"
  >
    <div class="absolute top-0 -left-30 border-l-1 border-secondary h-35 dark:border-lightsecondary"></div>
    <div class="absolute top-37 -left-30 -translate-x-1/2 flex flex-col items-center gap-4">
      <ThemeToggle class="text-secondary" />
      <a href="https://github.com/DylanZM" target="_blank" class="text-secondary hover:text-primary transition-colors duration-200">
        <GitHubIcon/>
      </a>
      <a href="mailto:dylanzarzuela62@gmail.com" class="text-secondary hover:text-primary transition-colors duration-200">
        <Mail />
      </a>
    </div>

    <a href="/" class="text-lg font-bold tracking-wide md:text-xl"
      >DylanZM</a
    >
    <ul
      class="hidden items-center space-x-6 text-sm font-medium tracking-wide md:flex"
    >
      <li>
        <a href="/" class="relative transition-colors duration-200 after:content-[''] after:absolute after:left-0 after:top-full after:mt-1 after:w-0 after:h-[3px] after:bg-primary after:transition-all after:duration-300 hover:after:w-full">Home</a>
        <li>
        <a href="#projects" class="relative transition-colors duration-200 after:content-[''] after:absolute after:left-0 after:top-full after:mt-1 after:w-0 after:h-[3px] after:bg-primary after:transition-all after:duration-300 hover:after:w-full">Projects</a>
        </li>
      </li>
      <li>
        <a href="#about" class="relative transition-colors duration-200 after:content-[''] after:absolute after:left-0 after:top-full after:mt-1 after:w-0 after:h-[3px] after:bg-primary after:transition-all after:duration-300 hover:after:w-full">About</a>
      </li>
      <li>
        <a href="#contact" class="relative transition-colors duration-200 after:content-[''] after:absolute after:left-0 after:top-full after:mt-1 after:w-0 after:h-[3px] after:bg-primary after:transition-all after:duration-300 hover:after:w-full">Contact</a>
      </li>
      <li class="relative">
        <button id="lang-toggle" type="button" aria-label="Toggle language" aria-expanded="false" class="flex items-center gap-2 cursor-pointer">
          <span id="lang-label">EN</span>
          <MorphIcon icon={ChevronDown} />
        </button>
        <ul id="lang-dropdown" class="hidden absolute top-full right-0 mt-2 py-1 px-3 border border-secondary text-sm font-semibold" style="background: var(--surface);">
          <li><button class="lang-option cursor-pointer block w-full text-left py-1 hover:text-primary transition-colors" data-lang="en">EN</button></li>
          <li><button class="lang-option cursor-pointer block w-full text-left py-1 hover:text-primary transition-colors" data-lang="es">ES</button></li>
        </ul>
      </li>
    </ul>
  </nav>
</header>

<script>
  import { ChevronDown, ChevronUp } from "lucide";
  import type { MorphIconElement } from "morphicons/element";

  const btn = document.querySelector<HTMLButtonElement>("#lang-toggle")!;
  const icon = btn.querySelector<MorphIconElement>("morph-icon")!;
  const dropdown = document.querySelector<HTMLUListElement>("#lang-dropdown")!;
  const label = document.querySelector<HTMLSpanElement>("#lang-label")!;

  btn.addEventListener("click", () => {
    const open = btn.getAttribute("aria-expanded") !== "true";
    btn.setAttribute("aria-expanded", String(open));
    icon.icon = open ? ChevronUp : ChevronDown;
    dropdown.classList.toggle("hidden", !open);
  });

  document.querySelectorAll(".lang-option").forEach((option) => {
    option.addEventListener("click", () => {
      const lang = option.getAttribute("data-lang")!;
      label.textContent = lang.toUpperCase();
      dropdown.classList.add("hidden");
      btn.setAttribute("aria-expanded", "false");
      icon.icon = ChevronDown;

      if (typeof (window as any).translateTo === "function") {
        (window as any).translateTo(lang);
      }
    });
  });

  document.addEventListener("click", (e) => {
    if (!btn.contains(e.target as Node) && !dropdown.contains(e.target as Node)) {
      dropdown.classList.add("hidden");
      btn.setAttribute("aria-expanded", "false");
      icon.icon = ChevronDown;
    }
  });
</script>




