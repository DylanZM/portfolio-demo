---
import { CodeXml } from "@lucide/astro";
import Frame27 from '../assets/decorations/Frame27.svg';
import Frame28 from '../assets/decorations/Frame28.svg';
import Frame29 from '../assets/decorations/Frame29.svg';
import Rectangle23 from '../assets/decorations/Rectangle 23.svg';
import Rectangle24 from '../assets/decorations/Rectangle 24.svg';
import TechIcon from './icons/Technologies.astro';
import { skills as categories } from '../data/skills';

const withOffsets = [];
let acc = 0;
for (const cat of categories) {
  withOffsets.push({ ...cat, offset: acc });
  acc += cat.skills.length;
}
---

<section id="skills" class="w-full py-16 px-6 sm:px-8 md:px-0 md:max-w-4xl md:mx-auto scroll-mt-24 reveal">
  <div class="flex flex-col gap-2 mb-10 text-left">
    <h2 class="flex flex-wrap items-center gap-3 text-[1.5rem] md:text-[2rem] tracking-wide font-medium">
      <span class="inline-flex">
        <CodeXml size={24} class="text-primary" />
      </span>
      <span data-i18n="skills.heading">skills</span>
      <div class="border-t border-primary line-draw" style="max-width: 239px;"></div>
    </h2>
    <p class="text-sm md:text-base text-secondary" data-i18n="skills.subtitle">
      Technologies and tools I work with.
    </p>
  </div>

  <div class="flex flex-row gap-4 md:gap-8">
    <!-- Decorations grouped like Group36 -->
    <div class="relative flex flex-col items-center gap-6 py-1 w-14 shrink-0 md:block md:w-[349px] md:h-[283px]" aria-hidden="true">
      <!-- Dot grid: top-left -->
      <Frame27 class="deco-float opacity-40 w-10 md:w-auto md:absolute md:top-[40px] md:left-0" style="animation-delay: 0s;" />
      <!-- Purple crosses: bottom-left -->
      <Frame29 class="deco-float opacity-30 w-12 md:w-auto md:absolute md:top-[169px] md:left-[15px]" style="animation-delay: 0.8s;" />
      <!-- Large square: top-right -->
      <Rectangle24 class="deco-float opacity-25 w-11 md:w-auto md:absolute md:top-0 md:right-[36px]" style="animation-delay: 1.6s;" />
      <!-- Dot grid 2: middle-right -->
      <Frame28 class="deco-float opacity-40 w-10 md:w-auto md:absolute md:top-[145px] md:left-[179px]" style="animation-delay: 2.4s;" />
      <!-- Small square: far-right -->
      <Rectangle23 class="deco-float opacity-30 w-9 md:w-auto md:absolute md:top-[193px] md:right-0" style="animation-delay: 3.2s;" />
    </div>

    <!-- Skill categories -->
    <div class="flex flex-col gap-6 md:gap-8 flex-1 min-w-0 reveal-stagger md:ml-40">
      {withOffsets.map((cat) => (
        <div class="reveal-child">
          <h3 class="text-xs sm:text-sm font-semibold tracking-wider uppercase mb-3 text-primary" data-i18n={cat.key}>{cat.name}</h3>
          <div class="flex flex-wrap gap-2">
            {cat.skills.map((skill, i) => (
              <span
                class="skill-tag inline-flex items-center justify-center p-1.5 border border-secondary"
                style={`background: var(--surface); --d: ${140 + (cat.offset + i) * 55}ms;`}
                aria-label={skill.name}
              >
                <TechIcon name={skill.icon} width={30} height={30} />
                <span class="skill-tip">{skill.name}</span>
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .deco-float {
    animation: decoFloat 5s ease-in-out infinite;
  }

  @keyframes decoFloat {
    0%, 100% {
      transform: translateY(0) rotate(0deg);
    }
    50% {
      transform: translateY(-10px) rotate(2deg);
    }
  }

  .skill-tag {
    position: relative;
    transition: border-color 200ms ease;
  }

  /* Tooltip */
  .skill-tip {
    position: absolute;
    bottom: calc(100% + 10px);
    left: 50%;
    translate: -50% 6px;
    scale: 0.85;
    padding: 3px 9px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.03em;
    line-height: 1.5;
    white-space: nowrap;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--secondary);
    box-shadow: 0 8px 20px -8px rgb(0 0 0 / 0.35);
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 130ms var(--ease-out),
      translate 130ms var(--ease-out),
      scale 130ms var(--ease-out);
  }

  .skill-tip::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    width: 8px;
    height: 8px;
    background: var(--surface);
    border-right: 1px solid var(--secondary);
    border-bottom: 1px solid var(--secondary);
    translate: -50% -5px rotate(45deg);
  }

  .skill-tag :global(svg) {
    transition: transform 180ms var(--ease-out);
  }

  :global(html.dark) .deco-float :global(svg) {
    filter: brightness(0.4) saturate(1.2);
  }

  @media (hover: hover) and (pointer: fine) {
    .skill-tag:hover {
      border-color: var(--primary);
      box-shadow:
        0 0 0 1px color-mix(in srgb, var(--primary) 30%, transparent),
        0 6px 18px -6px color-mix(in srgb, var(--primary) 50%, transparent);
      translate: 0 -2px;
    }

    .skill-tag:hover :global(svg) {
      transform: scale(1.08);
    }

    .skill-tag:hover .skill-tip {
      opacity: 1;
      translate: -50% 0;
      scale: 1;
      transition-delay: 250ms;
    }
  }

  .skill-tag:active {
    scale: 0.94;
  }
</style>
