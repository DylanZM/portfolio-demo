---
import Arrow from './icons/Arrow.astro';
import { CodeXml } from "@lucide/astro";
import Frame27 from '../assets/decorations/Frame27.svg';
import Frame28 from '../assets/decorations/Frame28.svg';
import Frame29 from '../assets/decorations/Frame29.svg';
import Rectangle23 from '../assets/decorations/Rectangle 23.svg';
import Rectangle24 from '../assets/decorations/Rectangle 24.svg';
import TechIcon from './icons/Technologies.astro';
import { skills as categories } from '../data/skills';
---

<section id="skills" class="w-full py-16 px-6 sm:px-8 md:px-0 md:max-w-4xl md:mx-auto scroll-mt-24 reveal">
  <div class="flex flex-col gap-2 mb-10 text-left">
    <h2 class="flex flex-wrap items-center gap-3 text-[1.5rem] md:text-[2rem] tracking-wide font-medium">
      <span class="inline-flex">
        <CodeXml size={24} class="text-primary" />
      </span>
      skills
      <div class="border-t border-primary line-draw" style="max-width: 239px;"></div>
    </h2>
    <p class="text-sm md:text-base" style="color: var(--secondary)">
      Technologies and tools I work with.
    </p>
  </div>

  <div class="flex flex-col md:flex-row md:gap-8">
    <!-- Decorations grouped like Group36 -->
    <div class="hidden md:block relative md:w-[349px] md:h-[283px] md:shrink-0" aria-hidden="true">
      <!-- Dot grid: top-left -->
      <Frame27 class="absolute top-[40px] left-0 deco-float opacity-40" style="animation-delay: 0s;" />
      <!-- Purple crosses: bottom-left -->
      <Frame29 class="absolute top-[169px] left-[15px] deco-float opacity-30" style="animation-delay: 0.8s;" />
      <!-- Large square: top-right -->
      <Rectangle24 class="absolute top-0 right-[36px] deco-float opacity-25" style="animation-delay: 1.6s;" />
      <!-- Dot grid 2: middle-right -->
      <Frame28 class="absolute top-[145px] left-[179px] deco-float opacity-40" style="animation-delay: 2.4s;" />
      <!-- Small square: far-right -->
      <Rectangle23 class="absolute top-[193px] right-0 deco-float opacity-30" style="animation-delay: 3.2s;" />
    </div>

    <!-- Skill categories -->
    <div class="flex flex-col gap-6 md:gap-8 flex-1 reveal-stagger md:ml-40">
      {categories.map((cat) => (
        <div class="reveal-child">
          <h3 class="text-xs sm:text-sm font-semibold tracking-wider uppercase mb-3" style="color: var(--primary);">{cat.name}</h3>
          <div class="flex flex-wrap gap-2">
            {cat.skills.map((skill, i) => (
              <span
                class="skill-tag inline-flex items-center justify-center p-1.5 border border-secondary"
                style={`background: var(--surface); --d: ${140 + i * 70}ms;`}
                title={skill.name}
                aria-label={skill.name}
              >
                <TechIcon name={skill.icon} width={30} height={30} />
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .deco-float {
    animation: decoFloat 5s ease-in-out infinite;
  }

  @keyframes decoFloat {
    0%, 100% {
      transform: translateY(0) rotate(0deg);
    }
    50% {
      transform: translateY(-10px) rotate(2deg);
    }
  }

  .skill-tag {
    transition: border-color 200ms ease;
  }

  .skill-tag :global(svg) {
    transition: transform 180ms var(--ease-out);
  }

  :global(html.dark) .deco-float :global(svg) {
    filter: brightness(0.4) saturate(1.2);
  }

  @media (hover: hover) and (pointer: fine) {
    .skill-tag:hover {
      border-color: var(--primary);
    }

    .skill-tag:hover :global(svg) {
      transform: scale(1.15);
    }
  }
</style>
